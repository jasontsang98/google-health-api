# Copy this file to .env and fill in the values from your Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# Set this to true only when you are ready to upload fact Parquet files to Drive.
UPLOAD_TO_DRIVE=false

# Drive API destination folder ID. Required when UPLOAD_TO_DRIVE=true.
GOOGLE_DRIVE_FOLDER_ID=

# Output directory. Use an absolute Windows path for another drive, or
# a relative path such as output for a folder inside this repository.
OUTPUT_DIR=output

# Root folder for versioned raw and transformed data.
DATA_ROOT=data

# Local Google Drive-synced folder for dbt fact-table Parquet exports.
# Example: G:\GoogleHealth\facts
GDRIVE_OUTPUT_DIR=

# The Health API endpoint to export.
HEALTH_API_URL=https://health.googleapis.com/v4/users/me/dataTypes/exercise/dataPoints

# Optional. Keep the default unless the target folder requires broader Drive access.
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# Use one exact redirect URI. Register this same value in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8080/
